# Basic server settings
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Store player accounts and sessions outside the project directory in production.
KWA_DATA_DIR=/var/lib/king-of-du

# Required when exposing the admin console to any network you do not fully trust.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace-with-a-long-random-token

# Set to true when the site is served through HTTPS.
COOKIE_SECURE=true

# Basic abuse protection.
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT=20
ACTION_RATE_LIMIT=180
JSON_BODY_LIMIT=1048576
