# Required. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace-with-a-long-random-token

# Host port exposed by Docker.
PUBLIC_PORT=3000

# Set to true when Docker is behind an HTTPS reverse proxy.
COOKIE_SECURE=false

RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT=20
ACTION_RATE_LIMIT=180
JSON_BODY_LIMIT=1048576
